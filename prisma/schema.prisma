generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(cuid())
  name         String        @unique
  users        User[]
  roadmaps     Roadmap[]
  backlogItems BacklogItem[]
  createdAt    DateTime      @default(now())
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  role           String       @default("viewer")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}

model Roadmap {
  id                 String            @id @default(cuid())
  name               String
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  startDate          String
  endDate            String
  programIncrements  ProgramIncrement[]
  epics              Epic[]
  features           Feature[]
  createdAt          DateTime          @default(now())
}

model ProgramIncrement {
  id        String   @id @default(cuid())
  roadmapId String
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id])
  name      String
  startDate String
  endDate   String
  createdAt DateTime @default(now())
}

model Epic {
  id          String   @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id])
  title       String
  description String?
  status      String   @default("planned")
  startDate   String?
  endDate     String?
  rank        Int      @default(0)
  createdAt   DateTime @default(now())
}

model Feature {
  id          String   @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id])
  epicId      String?
  title       String
  description String?
  status      String   @default("planned")
  startDate   String?
  endDate     String?
  rank        Int      @default(0)
  pi          String?
  team        String?
  createdAt   DateTime @default(now())
}

model BacklogItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  type           String       @default("feature")
  status         String       @default("new")
  priority       Int          @default(0)
  createdAt      DateTime     @default(now())
}

model ExternalLink {
  id          String   @id @default(cuid())
  itemType    String
  itemId      String
  system      String
  externalId  String
  externalUrl String
  createdAt   DateTime @default(now())
}
